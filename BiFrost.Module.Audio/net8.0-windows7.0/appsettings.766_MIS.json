{
  "BiFrostServer": {
    "Resources": {
      "IAtfAmpCalibrationResource": {
        "Concrete": "AtfDualAlc1320AmpCalibrationResource",
        "Lifetime": "SingletonPreload"
      }
    }
  },
  "AtfResource": {
    "UseAmpChannelEnable": true,
    "UseMteMode": false,
    "Endpoints": {
      "Speakers": "Speakers",
      "Capture": "Stereo Microphone",
      "ExternalRender": "Headset Earphone",
      "ExternalCapture": "Headset Microphone"
    },
    "AudioDevices": {
      "LeftSpeaker0": {
        "Endpoint": "Speakers",
        "Channel": 0
      },
      "LeftSpeaker1": {
        "Endpoint": "Speakers",
        "Channel": 1
      },
      "RightSpeaker0": {
        "Endpoint": "Speakers",
        "Channel": 2
      },
      "RightSpeaker1": {
        "Endpoint": "Speakers",
        "Channel": 3
      },
      "LeftMic": {
        "Endpoint": "Capture",
        "Channel": 0
      },
      "RightMic": {
        "Endpoint": "Capture",
        "Channel": 1
      },
      "Headphones": {
        "Endpoint": "ExternalRender"
      },
      "LeftHeadphones": {
        "Endpoint": "ExternalRender",
        "Channel": 0
      },
      "RightHeadphones": {
        "Endpoint": "ExternalRender",
        "Channel": 1
      },
      "Headset": {
        "Endpoint": "ExternalCapture"
      }
    }
  }
}