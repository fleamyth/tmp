<?xml version="1.0" encoding="utf-8"?>
<DebugModule Name="mUSL" Class="Microsoft.Devices.SurfaceDebugFramework.DebugModule.StandardDebugModule"
  xmlns="DebugModuleSchemaNs">
  <DebugModes>

    <DebugModeTypes Name="DebugModeTypes" Description="List of acceptable Debug Mode types. Case Sensitive.">
      <Type Name="Default"/>
      <Type Name="UefiLog"/>
	  <Type Name="DefmtLog"/>
    </DebugModeTypes>

    <DebugMode Name="Default" Type="Default" ProductId="65535" McuCommands="">
      <Filter Name="CommandFilter" Class="Microsoft.Devices.SurfaceDebugFramework.IOFilter.CommandFilter" Description="Filter identifier to use.">
        <Protocol Name="CommandProtocol" Class="Microsoft.Devices.SurfaceDebugFramework.IOProtocol.UartProtocol" Description="IOProtocol to communicate.">
          <Field Name="FTDI.Uart" Default="" Description="UART Port for MCU commands"/>
          <Field Name="Baudrate" Default="3000000" Description="Connection Baud Rate."/>
        </Protocol>
      </Filter>
    </DebugMode>
    <DebugMode Name="UefiLog" Type="UefiLog" ProductId="65535" McuCommands="">
      <Filter Name="AsciiLogFilter" Class="Microsoft.Devices.SurfaceDebugFramework.IOFilter.AsciiLogFilter" Description="">
        <Protocol Name="UefiLogProtocol" Class="Microsoft.Devices.SurfaceDebugFramework.IOProtocol.UartProtocol" Description="IOProtocol to listen to UEFI output">
          <Field Name="FTDI.Uart" Default="" Description="Port for UEFI debug output"/>
          <Field Name="Baudrate" Default="57600" Description="Connection Baud Rate."/>
          <Field Name="ReadOperation" Default="ReadLine" Description="Data is expected to be in ASCII format with newlines so use the ReadLine method of System.IO.Ports.SerialPort instead of the binary Read() method."/>
        </Protocol>
      </Filter>
    </DebugMode>
	
	  <DebugMode Name="DefmtLog" Type="DefmtLog" ProductId="65535" McuCommands="">
      <Filter Name="DefmtLogFilter" Class="Microsoft.Devices.SurfaceDebugFramework.IOFilter.DefmtLogFilter" Description="">
        <Protocol Name="UefiLogProtocol" Class="Microsoft.Devices.SurfaceDebugFramework.IOProtocol.UartProtocol" Description="IOProtocol to listen to UEFI output">
          <Field Name="FTDI.Uart" Default="" Description="Port for UEFI debug output"/>
          <Field Name="Baudrate" Default="57600" Description="Connection Baud Rate."/>
        </Protocol>
      </Filter>
    </DebugMode>

  </DebugModes>

</DebugModule>