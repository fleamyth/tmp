{
  "BiFrostServer": {
    "Resources": {
      "IAtfAmpCalibrationResource": {
        "Concrete": "AtfAlc1320AmpCalibrationResource",
        "Lifetime": "SingletonPreload"
      }
    }
  },
  "AtfResource": {
    "Endpoints": {
      "Render": "Surface Omnisonic Speakers",
      "Capture": "Surface Stereo Microphones",
      "ExternalRender": "Headset Earphones",
      "ExternalCapture": "Headset Microphone",
      "Loopback": "Speakers"
    },
    "AudioDevices": {
      "LeftSpeaker": {
        "Endpoint": "Render",
        "Channel": 0
      },
      "RightSpeaker": {
        "Endpoint": "Render",
        "Channel": 1
      },
      "LeftMic": {
        "Endpoint": "Capture",
        "Channel": 0,
        "IsSignalPreCheckEnabled": true,
        "SignalPreCheckConfigurations": [
          {
            "ChannelToCompare": 1,
            "EuclideanDistanceThreshold": 1.0
          }
        ]
      },
      "RightMic": {
        "Endpoint": "Capture",
        "Channel": 1,
        "IsSignalPreCheckEnabled": true,
        "SignalPreCheckConfigurations": [
          {
            "ChannelToCompare": 0,
            "EuclideanDistanceThreshold": 1.0
          }
        ]
      },
      "Headphones": {
        "Endpoint": "ExternalRender"
      },
      "LeftHeadphones": {
        "Endpoint": "ExternalRender",
        "Channel": 0
      },
      "RightHeadphones": {
        "Endpoint": "ExternalRender",
        "Channel": 1
      },
      "Headset": {
        "Endpoint": "ExternalCapture"
      },
      "Loopback": {
        "Endpoint": "Loopback"
      }
    }
  }
}