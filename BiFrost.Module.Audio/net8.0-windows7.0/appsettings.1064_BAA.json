{
  "BiFrostServer": {
    "Resources": {
      "IAtfAmpCalibrationResource": {
        "Concrete": "AtfAlc1320AmpCalibrationResource",
        "Lifetime": "SingletonPreload"
      }
    }
  },
  "AtfResource": {
    "UseMteMode": true,
    "Endpoints": {
      "Render": "Speakers",
      "Capture": "Surface Stereo Microphones||Microphone Array",
      "ExternalRender": "Headset Earphone",
      "ExternalCapture": "Headset Microphone",
      "Loopback": "Speakers"
    },
    "AudioDevices": {
      "LeftSpeaker": {
        "Endpoint": "Render",
        "Channel": 0
      },
      "RightSpeaker": {
        "Endpoint": "Render",
        "Channel": 1
      },
      "LeftMic": {
        "Endpoint": "Capture",
        "Channel": 0
      },
      "RightMic": {
        "Endpoint": "Capture",
        "Channel": 1
      },
      "Headphones": {
        "Endpoint": "ExternalRender"
      },
      "LeftHeadphones": {
        "Endpoint": "ExternalRender",
        "Channel": 0
      },
      "RightHeadphones": {
        "Endpoint": "ExternalRender",
        "Channel": 1
      },
      "Headset": {
        "Endpoint": "ExternalCapture"
      },
      "Loopback": {
        "Endpoint": "Loopback"
      }
    }
  }
}